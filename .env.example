# Strongest model already deployed on the subscription: gpt-5.4 (deployment report-synthesis).
# Leave these blank to use the deterministic letter, which does not call a model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=report-synthesis
AZURE_OPENAI_MODEL=gpt-5.4
AZURE_OPENAI_API_VERSION=2024-10-21

# Set this before a hosted deploy. Locally, leave it empty.
APP_PASSWORD=

TECTONIC_PATH=/opt/homebrew/bin/tectonic
