# Azure OpenAI. GPT-4.1 is the deployment this studio is written for.
# Leave these blank to use the deterministic letter, which does not call a model.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# Set this before a hosted deploy. Locally, leave it empty.
APP_PASSWORD=

TECTONIC_PATH=/opt/homebrew/bin/tectonic
